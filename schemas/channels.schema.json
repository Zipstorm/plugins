{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release channel examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "channels"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "beta", "canary"],
      "properties": {
        "stable": { "$ref": "#/$defs/channel" },
        "beta": { "$ref": "#/$defs/channel" },
        "canary": { "$ref": "#/$defs/channel" }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionExample", "tagExample"],
      "properties": {
        "versionExample": { "type": "string" },
        "tagExample": { "type": "string" }
      }
    }
  }
}
