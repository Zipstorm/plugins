{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recruiting plugin suite configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suiteVersion", "agentPluginsSpecVersion", "description", "author", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "suiteVersion": { "type": "string" },
    "agentPluginsSpecVersion": { "const": "1.0.0" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "name", "adapter", "packageMode"],
        "properties": {
          "profile": { "type": "string" },
          "name": { "type": "string" },
          "adapter": { "type": ["string", "null"] },
          "packageMode": { "enum": ["portable", "portable-scaffold", "codex-native"] }
        }
      }
    }
  }
}
